#!/bin/bash

ORIGPATH=$PATH

command=$0
if [ "$1" == "-E" ] || [ "$1" == "-N" ] || [ "$1" == "-C" ] || [ "$1" == "-I" ]; then
  test_mode=$1
  shift
else
  test_mode="-E"
fi

# Held as an array so that a track name containing a space survives; the
# previous string form embedded literal quotes into the argument itself.
test_track=()
individual_test=""
while [ "${1:-}" != "" ]; do
  case "$1" in
    "--test")
      shift
      individual_test=$1
      ;;
    "--track")
      shift
      test_track=(--track "$1")
      ;;
  esac
  shift
done

# Empty for a single-configuration generator, which picks its configuration
# at configure time.
config_arg=(@PLUSBUILD_CTEST_CONFIG_ARG@)

case "$test_mode" in
  "-E")
    "@CMAKE_CTEST_COMMAND@" "${config_arg[@]}" -D Experimental --output-on-failure "${test_track[@]}"
    ;;
  "-N")
    "@CMAKE_CTEST_COMMAND@" "${config_arg[@]}" -D Nightly "${test_track[@]}"
    ;;
  "-C")
    "@CMAKE_CTEST_COMMAND@" "${config_arg[@]}" -D Continuous "${test_track[@]}"
    # Pause so that the results of the run can be read before it scrolls away.
    sleep 15
    ;;
  "-I")
    # List the matching tests, then run them.
    "@CMAKE_CTEST_COMMAND@" "${config_arg[@]}" -R "$individual_test" -N
    "@CMAKE_CTEST_COMMAND@" "${config_arg[@]}" -R "$individual_test" -V
    ;;
esac

PATH=$ORIGPATH
echo "DONE"
